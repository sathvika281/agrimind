# Generate with: py -3.13 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
DATABASE_URL=sqlite:///./agrimind.db
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# AI provider: demo (default, no key needed) or gemini
AI_PROVIDER=demo
# Only needed when AI_PROVIDER=gemini. Get a key from Google AI Studio. Never commit it.
GEMINI_API_KEY=
# Configurable model name (default: gemini-2.5-flash)
GEMINI_MODEL=

# Image uploads (stored in backend/uploads/, served only via the authenticated endpoint)
MAX_IMAGE_MB=5

# Optional: logging and in-process rate limits (defaults are generous for normal use)
# LOG_LEVEL=INFO
# RATE_LIMIT_ENABLED=true
# RL_LOGIN_PER_EMAIL=15      # per IP+email per 5 min
# RL_LOGIN_PER_IP=100        # per IP per 5 min
# RL_REGISTER_PER_IP=50      # per IP per hour
# RL_ANALYSIS_PER_USER=40    # per user per 10 min

# Deployment (see DEPLOYMENT.md and ../.env.production.example)
# APP_ENV=production            # refuses to start with unsafe settings (short JWT_SECRET, COOKIE_SECURE=false, http CORS, demo AI, no Gemini key, rate limits off)
# ALLOW_DEMO_IN_PRODUCTION=false  # only true for a deliberate demo deployment
# FRONTEND_DIST=../frontend/dist  # built website served by app.asgi_prod:app
# UPLOADS_DIR=./uploads
# Build-time, frontend: VITE_CONTACT_EMAIL=you@example.com  (shown on the Privacy page)

# Agentic investigation (default false). Trusted-document corpus lives in backend/knowledge (python -m app.rag.discover / app.rag.ingest).
# AGENTIC_ANALYSIS_ENABLED=false
# KNOWLEDGE_DIR=./knowledge

# Weather: OpenWeather (free key from openweathermap.org) is used first when set; Open-Meteo (no key) is the automatic backup.
# OPENWEATHER_API_KEY=
# WEATHER_PROVIDER=auto   # auto | openweather | openmeteo
