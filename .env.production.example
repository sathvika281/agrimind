# Copy to .env.production and fill in. NEVER commit the real file. The app REFUSES to start if these are unsafe.
APP_ENV=production

# 48+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Behind Caddy the site is HTTPS, so cookies must be Secure.
COOKIE_SECURE=true

# Same-origin deployment: leave empty. Only list https:// origins if the website is served from elsewhere.
CORS_ORIGINS=

# Real AI. (demo is blocked in production unless ALLOW_DEMO_IN_PRODUCTION=true)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Inside the container these are already set to the /data volume; change only if you know why.
# DATABASE_URL=sqlite:////data/agrimind.db
# UPLOADS_DIR=/data/uploads
MAX_IMAGE_MB=5

# Rate limits are per process (the image runs ONE worker). Defaults suit a small pilot.
# RL_LOGIN_PER_EMAIL=15
# RL_LOGIN_PER_IP=100
# RL_REGISTER_PER_IP=50
# RL_ANALYSIS_PER_USER=40
LOG_LEVEL=INFO

# Agentic investigation (LangGraph specialists + trusted-document retrieval). Off by default: the single-call pipeline is used.
# Turn on only after you have compared answers on real photos (python -m app.agentic_compare).
AGENTIC_ANALYSIS_ENABLED=false
